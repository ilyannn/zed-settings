[
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": [
        "terminal::SendText",
        "\u001b\r"
      ]
    }
  },
  {
    "context": "MarkdownPreview",
    "bindings": {
      "escape": "markdown::CloseAndReturnToEditor",
      "space m": "markdown::CloseAndReturnToEditor"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "space t": ["task::Spawn", { "task_name": "bb: Tasks" }],
      "space .": "task::Rerun",
      "space space": "task::Spawn"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu && extension == bb",
    "bindings": {
      "space r": ["task::Spawn", { "task_name": "bb: Run Current File" }]
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu && extension == md",
    "bindings": {
      "space m": "markdown::OpenPreview"
    }
  }
]
